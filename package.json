{
  "name": "phaserquest",
  "version": "1.0.0",
  "description": "Clone of Mozilla's BrowserQuest with the Phaser engine",
  "main": "server.js",
  "scripts": {
    "dev": "bun --watch server.js --dev",
    "build": "bun --bun vite build",
    "start": "bun server.js"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jerenaux/phaserquest"
  },
  "keywords": [
    "Browserquest",
    "Phaser",
    "online",
    "game",
    "html5"
  ],
  "author": "Jerome Renaux",
  "license": "MIT",
  "homepage": "https://github.com/Jerenaux/phaserquest#readme",
  "dependencies": {
    "clone": "^2.1.0",
    "easystarjs": "^0.4.1",
    "express": "^5.1.0",
    "mongodb": "^7.0.0",
    "pathfinding": "^0.4.18",
    "phaser": "2.6.2",
    "quickselect": "^1.0.0",
    "random-weighted-choice": "^0.1.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "vite": "^8.0.0"
  }
}
