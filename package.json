{
  "name": "phaserquest",
  "version": "1.0.0",
  "description": "Clone of Mozilla's BrowserQuest with the Phaser engine",
  "main": "server.js",
  "scripts": {
    "dev": "bun --watch server.js --dev",
    "build": "bun --bun vite build",
    "typecheck": "tsc --noEmit",
    "start": "bun server.js"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jerenaux/phaserquest"
  },
  "keywords": [
    "Browserquest",
    "Phaser",
    "online",
    "game",
    "html5"
  ],
  "author": "Jerome Renaux",
  "license": "MIT",
  "homepage": "https://github.com/Jerenaux/phaserquest#readme",
  "dependencies": {
    "@colyseus/schema": "5.0.50",
    "@colyseus/sdk": "0.18.10",
    "@colyseus/ws-transport": "0.18.5",
    "colyseus": "0.18.12",
    "easystarjs": "^0.4.1",
    "express": "^5.1.0",
    "mongodb": "^7.0.0",
    "pathfinding": "^0.4.18",
    "phaser": "4.2.1",
    "random-weighted-choice": "^0.1.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/express": "^5",
    "typescript": "^7.0.2",
    "vite": "^8.0.0"
  }
}
